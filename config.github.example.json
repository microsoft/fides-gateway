{
  "mcpServers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ghp_replace_me"
      },
      "middleware": [
        {
          "type": "StripFastmcpMetaMiddleware"
        },
        {
          "type": "GitHubLabellingMiddleware"
        },
        {
          "type": "PolicyMiddleware",
          "policies": {
            "list_issues": { "literal": "package fides.policy\n\ndefault allow := true\ndefault msg := \"\"\n" },
            "get_issue": { "literal": "package fides.policy\n\ndefault allow := true\ndefault msg := \"\"\n" },
            "get_pull_request": { "literal": "package fides.policy\n\ndefault allow := true\ndefault msg := \"\"\n" },
            "create_issue": { "literal": "package fides.policy\n\ndefault allow := true\ndefault msg := \"\"\n" },
            "delete_file": { "literal": "package fides.policy\n\ndefault allow := true\ndefault msg := \"\"\n" }
          }
        },
        {
          "type": "ToolAnnotationsMiddleware",
          "toolAnnotations": {
            "*": {
              "readOnlyHint": false,
              "openWorldHint": true,
              "destructiveHint": true,
              "idempotentHint": false
            },
            "list_issues": {
              "readOnlyHint": true,
              "destructiveHint": false,
              "idempotentHint": true
            },
            "get_issue": {
              "readOnlyHint": true,
              "destructiveHint": false,
              "idempotentHint": true
            },
            "get_pull_request": {
              "readOnlyHint": true,
              "destructiveHint": false,
              "idempotentHint": true
            },
            "create_issue": {
              "openWorldHint": false,
              "destructiveHint": false
            },
            "delete_file": {
              "openWorldHint": false,
              "idempotentHint": true
            }
          }
        }
      ]
    }
  }
}

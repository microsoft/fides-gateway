{
  "mcpServers": {
    "workiq": {
      "type": "http",
      "url": "https://workiq.svc.cloud.microsoft/mcp",
      "msal": {
        "tenantId": "090fc601-8371-4167-8b63-dd3a11028a43",
        "clientId": "ec3a7b3c-4991-46fe-9be6-3b153c9cc931",
        "scopes": ["https://agent365.svc.cloud.microsoft/.default"],
        "callbackPort": 8080
      },
      "middleware": [
        {
          "type": "MetaPrefixTranslationMiddleware",
          "prefixMap": {
            "ifc.policy": "com.github.ifc/policy",
            "ifc": "com.github.ifc/labels"
          }
        },
        {
          "type": "LabelConversionMiddleware"
        },
        {
          "type": "StripFastmcpMetaMiddleware"
        },
        {
          "type": "WorkIQLabellingMiddleware",
          "labellers": {
            "fetch": {
              "pathArg": "entityUrls",
              "rules": [
                {
                  "path": "/chats/*/members",
                  "labeller": "teamsMembers"
                },
                {
                  "path": "/me/chats/*/members",
                  "labeller": "teamsMembers"
                },
                {
                  "path": "/users/*/chats/*/members",
                  "labeller": "teamsMembers"
                },
                {
                  "path": "/teams/*/channels/*/members",
                  "labeller": "teamsMembers"
                },
                {
                  "path": "/chats/*/messages/**",
                  "labeller": "teamsMessages"
                },
                {
                  "path": "/me/chats/*/messages/**",
                  "labeller": "teamsMessages"
                },
                {
                  "path": "/users/*/chats/*/messages/**",
                  "labeller": "teamsMessages"
                },
                {
                  "path": "/teams/*/channels/*/messages/**",
                  "labeller": "teamsMessages"
                },
                {
                  "path": "/me/messages/**",
                  "labeller": "outlookMail"
                },
                {
                  "path": "/me/mailFolders/*/messages/**",
                  "labeller": "outlookMail"
                },
                {
                  "path": "/users/*/messages/**",
                  "labeller": "outlookMail"
                },
                {
                  "path": "/me/events/**",
                  "labeller": "calendarEvents"
                },
                {
                  "path": "/me/calendar/events/**",
                  "labeller": "calendarEvents"
                },
                {
                  "path": "/me/calendarView/**",
                  "labeller": "calendarEvents"
                },
                {
                  "path": "/me/calendars/*/calendarView/**",
                  "labeller": "calendarEvents"
                }
              ]
            }
          }
        },
        {
          "type": "PolicyMiddleware",
          "policies": {
            "*": {
              "file": "policies/deny.rego"
            },
            "search_paths": {
              "file": "policies/allow.rego"
            },
            "get_schema": {
              "file": "policies/allow.rego"
            },
            "list_agents": {
              "file": "policies/allow.rego"
            },
            "fetch": {
              "file": "policies/allow.rego"
            },
            "fetch_blob": {
              "file": "policies/allow.rego"
            },
            "ask": {
              "file": "policies/allow.rego"
            },
            "create_entity": {
              "pathArg": "parentUrl",
              "rules": [
                {
                  "path": "/chats/*/messages",
                  "file": "policies/workiq/teams/messages.rego"
                },
                {
                  "path": "/me/chats/*/messages",
                  "file": "policies/workiq/teams/messages.rego"
                },
                {
                  "path": "/users/*/chats/*/messages",
                  "file": "policies/workiq/teams/messages.rego"
                },
                {
                  "path": "/teams/*/channels/*/messages",
                  "file": "policies/workiq/teams/messages.rego"
                },
                {
                  "path": "/teams/*/channels/*/messages/*/replies",
                  "file": "policies/workiq/teams/messages.rego"
                }
              ]
            }
          }
        },
        {
          "type": "ToolAnnotationsMiddleware",
          "toolAnnotations": {
            "*": {
              "readOnlyHint": false,
              "openWorldHint": true,
              "destructiveHint": true,
              "idempotentHint": false
            },
            "search_paths": {
              "readOnlyHint": true,
              "destructiveHint": false,
              "idempotentHint": true
            },
            "get_schema": {
              "readOnlyHint": true,
              "destructiveHint": false,
              "idempotentHint": true
            },
            "list_agents": {
              "readOnlyHint": true,
              "destructiveHint": false,
              "idempotentHint": true
            },
            "fetch": {
              "readOnlyHint": true,
              "destructiveHint": false,
              "idempotentHint": true
            },
            "fetch_blob": {
              "readOnlyHint": true,
              "destructiveHint": false,
              "idempotentHint": true
            },
            "ask": {
              "readOnlyHint": true,
              "destructiveHint": false,
              "idempotentHint": true
            }
          }
        },
        {
          "type": "OutputSchemaMiddleware",
          "outputSchemas": {
            "ask": {
              "type": "object",
              "properties": {
                "answer": {
                  "type": "string"
                },
                "conversationId": {
                  "type": "string"
                }
              },
              "required": [
                "answer",
                "conversationId"
              ]
            },
            "search_paths": {
              "type": "object",
              "properties": {
                "paths": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string"
                      },
                      "operations": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "operationDetails": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "operation": {
                              "type": "string"
                            },
                            "uriTemplate": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "operation"
                          ]
                        }
                      }
                    },
                    "required": [
                      "path",
                      "operations",
                      "operationDetails"
                    ]
                  }
                }
              },
              "required": [
                "paths"
              ]
            },
            "fetch_blob": {
              "type": "object",
              "properties": {
                "statusCode": {
                  "type": "integer"
                },
                "sizeBytes": {
                  "type": "integer"
                },
                "base64Content": {
                  "type": "string"
                },
                "error": {
                  "type": [
                    "string",
                    "object",
                    "null"
                  ]
                },
                "requestId": {
                  "type": "string"
                }
              },
              "required": [
                "statusCode",
                "sizeBytes",
                "base64Content"
              ]
            },
            "delete_entity": {
              "type": "object",
              "properties": {
                "statusCode": {
                  "type": "integer"
                },
                "data": {},
                "error": {
                  "type": [
                    "object",
                    "null"
                  ]
                },
                "requestId": {
                  "type": "string"
                }
              },
              "required": [
                "statusCode"
              ]
            }
          }
        }
      ]
    }
  }
}
